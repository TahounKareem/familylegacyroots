rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
  
    // ==========================================
    // Authentication & Authorization Helpers
    // ==========================================
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token != null && request.auth.token.email != null && request.auth.token.email.lower() == 'kareem.tahoun@adamresearchcenter.net') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // ==========================================
    // Users Collection
    // ==========================================
    match /users/{userId} {
      allow read, write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }
    
    // ==========================================
    // Orders Collection
    // ==========================================
    match /orders/{orderId} {
      allow read: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if isSignedIn() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }
    
    // ==========================================
    // Email triggers
    // ==========================================
    match /mail/{mailId} {
      allow create: if isSignedIn();
      allow read, write: if isAdmin();
    }
    
    // ==========================================
    // Support Tickets
    // ==========================================
    match /support_tickets/{ticketId} {
      allow create: if isSignedIn();
      allow read, write: if isAdmin();
    }
    
    // ==========================================
    // Visitor Consents
    // ==========================================
    match /visitor_consents/{id} {
      allow create: if true;
      allow read, write: if isAdmin();
    }

    // ==========================================
    // ===== جداول الإثباتات القانونية (Legal Evidence) =====
    // ==========================================

    match /legal_versions/{versionId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    
    match /legal_contracts/{contractId} {
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin()) && (isAdmin() || (
        request.resource.data.customerSnapshot == resource.data.customerSnapshot &&
        request.resource.data.shippingSnapshot == resource.data.shippingSnapshot &&
        request.resource.data.orderSnapshot == resource.data.orderSnapshot &&
        request.resource.data.contractVersion == resource.data.contractVersion &&
        request.resource.data.contractGeneratedAt == resource.data.contractGeneratedAt
      ));
    }

    match /legal_consents/{consentId} {
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false; // أمنياً: لا يمسح ولا يتعدل أبداً بعد إنشائه
    }

    match /order_evidence/{evidenceId} {
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin()) && (isAdmin() || (
        request.resource.data.orderDetailsSnapshot == resource.data.orderDetailsSnapshot &&
        request.resource.data.orderId == resource.data.orderId &&
        request.resource.data.contractId == resource.data.contractId
      ));
      allow delete: if false;
    }

    match /audit_logs/{logId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }
    
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
